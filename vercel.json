{
  "git": {
    "deploymentEnabled": false
  },
  "installCommand": "cd mobile && npm ci",
  "buildCommand": "cd mobile && npx expo export --platform web",
  "outputDirectory": "mobile/dist",
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
