{
  "expo": {
    "name": "時光膠囊",
    "slug": "time-capsule",
    "scheme": "timecapsule",
    "orientation": "portrait",
    "icon": "../design/art/app-icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "打開地點膠囊時，時光膠囊會確認你是否在 100 米內。 Time Capsule checks that you are within 100 m when opening a place capsule."
        }
      ],
      ["expo-audio", { "microphonePermission": "時光膠囊會用麥克風錄下你想封存在膠囊裡的聲音。 Time Capsule uses the microphone to record a voice note you seal in a capsule.", "recordAudioAndroid": true, "enableBackgroundPlayback": false }],
      "expo-notifications",
      ["expo-camera", { "cameraPermission": "時光膠囊會用相機掃描定向任務現場的 QR 碼。 Time Capsule uses the camera to scan the QR code at a hunt quest.", "microphonePermission": false, "recordAudioAndroid": false }]
    ],
    "web": {
      "bundler": "metro",
      "name": "時光膠囊"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.timecapsule.mobile"
    },
    "android": {
      "package": "app.timecapsule.mobile",
      "adaptiveIcon": {
        "foregroundImage": "../design/art/app-icon.png",
        "backgroundColor": "#F6F8FB"
      }
    }
  }
}
