{
  "expo": {
    "name": "時光膠囊",
    "slug": "time-capsule",
    "scheme": "timecapsule",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      ["expo-location", { "locationWhenInUsePermission": "打開地點膠囊時，時光膠囊會確認你是否在 100 米內。 Time Capsule checks that you are within 100 m when opening a place capsule." }]
    ],
    "web": {
      "bundler": "metro",
      "name": "時光膠囊"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.timecapsule.mobile"
    },
    "android": {
      "package": "app.timecapsule.mobile"
    }
  }
}
